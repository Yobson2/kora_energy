# Copy to .env.local. Every variable is optional in development.

# Public URL, used for canonical links, the sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://kora-energy.example

# Signs back-office session cookies. REQUIRED in production (32+ characters);
# the server refuses to sign sessions without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KORA_SESSION_SECRET=

# The back-office account. Generate the hash with:
#   npm run hash-password -- "a long passphrase"
KORA_ADMIN_EMAIL=
KORA_ADMIN_PASSWORD_HASH=

# Publishes the demo account (shown on the sign-in page) in production, so
# portfolio reviewers can explore the back office. Always on in development.
KORA_DEMO_LOGIN=false

# Storage adapter: "file" (default, .data/kora.json) or "memory" (per process,
# resets on restart  use on read-only hosts such as serverless platforms).
KORA_STORE=file
